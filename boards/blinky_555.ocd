board blinky555 40x30 2L
use psu.ocd as PSU
part C1 C0805 10u
part C2 C0805 100n
part D1 LED0805 red
part R1 R0805 4k7
part R2 R0805 10k
part R3 R0805 330
part U1 SOIC8 NE555
GND L1 w0.5 :: C1.1 <--> C2.2 <--> D1.2 <--> U1.1
N_CV L0 :: C2.1 <--> U1.5
N_DIS L1 :: R1.2 <--> R2.1 <--> U1.7
N_LED L0 :: D1.1 <--> R3.2
N_OUT L1 :: R3.1 <--> U1.3
N_TH L0 :: C1.2 <--> R2.2 <--> U1.2 <--> U1.6
VCC L0 w0.5 :: R1.1 <--> U1.4 <--> U1.8
fix PSU_J1 at 3 15
keep U1 near C1 3
keep U1 near C2 3
power VCC GND

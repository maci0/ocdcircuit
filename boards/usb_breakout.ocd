# USB-C breakout: exotic edge-mount plug demo. The tongue hangs off the
# bottom edge; DRC exempts it (edge flag), placer keeps it at the rim.
# python ocd.py examples/usb_breakout.ocd
board usbbrk 30x24 2L
fp usb_c_edge.fp
part J1 USB_C_EDGE_GCT GCT-USB4515
part R1 R0805 5k1
part R2 R0805 5k1
part C1 C0805 100n
net VBUS: J1.A4 J1.A9 J1.B4 J1.B9 C1.1
net GND: J1.A1 J1.A12 J1.B1 J1.B12 J1.S1 J1.S2 C1.2
net CC1: J1.A5 R1.1
net CC2: J1.B5 R2.1
net CFG: R1.2 R2.2
fix J1 at 15 23
power VBUS GND
nc J1.A2 J1.A3 J1.A6 J1.A7 J1.A8 J1.A10 J1.A11 J1.B2 J1.B3 J1.B6 J1.B7 J1.B8 J1.B10 J1.B11

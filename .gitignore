# board knowledgebase: notes AND datasheets are committed (they are the
# project's documentation — 1-10MB each, so a repo with many boards gets
# heavy; ignore boards/*/kb/datasheets/*.pdf if that ever bites). Only the
# derived text/vector caches are ignored.
boards/*/kb/.cache/
boards/kb/.cache/

# Local secrets / operator overrides (never commit)
.env
.env.local
.ocd-users
